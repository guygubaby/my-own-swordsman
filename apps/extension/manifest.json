{
  "manifest_version": 3,
  "name": "同福娱乐镇 · 央视网弹幕",
  "version": "0.2.6",
  "description": "在央视网《武林外传》播放页叠加同福娱乐镇的弹幕，并支持发弹幕。不改动视频流。",
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://tongfu.guygubaby.top/*",
    "https://tv.cctv.com/*",
    "https://*.cctv.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "同福弹幕 · 未连接",
    "default_icon": {
      "16": "icons/off-16.png",
      "32": "icons/off-32.png",
      "48": "icons/off-48.png",
      "128": "icons/off-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://tv.cctv.com/*", "https://*.cctv.com/*"],
      "js": ["content-cctv.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://tongfu.guygubaby.top/*"],
      "js": ["content-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
