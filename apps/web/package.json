{
  "name": "web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "build": "tsc -b && cf build",
    "deploy": "cf deploy --secrets-file .dev.vars",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "cf d1 migrations apply 33c17fba-0b19-4a10-8f6b-2142af118738 --local --dir ./drizzle --persist-to ./.cloudflare/state",
    "db:migrate:remote": "cf d1 migrations apply 33c17fba-0b19-4a10-8f6b-2142af118738 --dir ./drizzle"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "^1.7.19",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "artplayer": "5.4.0",
    "artplayer-plugin-danmuku": "5.3.0",
    "better-auth": "1.7.19",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "ky": "^2.2.0",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "ufo": "^1.6.4",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.12",
    "@cloudflare/workers-types": "^5.20261109.1",
    "@eslint/js": "^10",
    "@tanstack/react-router-devtools": "^1.167.3",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "cf": "1.0.0-beta.22",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^5.1.0"
  }
}
